# ---------------------------------------------------------------------------
# /oneroof invite-only auth
#
# Copy to .env.local for local dev. .env.local is gitignored; this example file
# is committed so the required variables are documented somewhere.
#
# In production every one of these must be set in the Vercel dashboard. The app
# refuses to boot the auth layer without them rather than falling back to
# anything weaker.
# ---------------------------------------------------------------------------

# Upstash Redis. Provisioned from Vercel -> Storage -> Upstash Redis, which
# injects both of these automatically. Leave them unset locally and the auth
# layer uses an in-memory store instead (dev only, wiped on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the session cookie. 32 random bytes, hex. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value logs everyone out.
ONEROOF_SESSION_SECRET=

# The one address that is always allowed and that owns /oneroof/admin.
ONEROOF_OWNER_EMAIL=cainmenard@gmail.com

# Resend. Leave RESEND_API_KEY unset locally and magic links print to the dev
# server console instead of being emailed.
RESEND_API_KEY=
ONEROOF_MAIL_FROM="Cain Menard <oneroof@cainmenard.com>"

# Used to build absolute magic-link URLs. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.cainmenard.com
